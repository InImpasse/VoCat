# Grant the unprivileged VoCat service access only to the supported DJI/Baiwang
# first-generation USB composition. Host-side VM passthrough is separately
# restricted by physical path and serial number.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2ca3", ATTRS{idProduct}=="4006", GROUP="vocat-modem", MODE="0660", TAG+="systemd"
SUBSYSTEM=="usbmisc", ATTRS{idVendor}=="2ca3", ATTRS{idProduct}=="4006", GROUP="vocat-modem", MODE="0660", TAG+="systemd"
SUBSYSTEM=="usb", ATTR{idVendor}=="2ca3", ATTR{idProduct}=="4006", GROUP="vocat-modem", MODE="0660"
