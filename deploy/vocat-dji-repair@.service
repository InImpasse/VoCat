[Unit]
Description=Repair DJI 4G modem AT/QMI bindings for VoCat
Documentation=file:///opt/vocat/current/docs/security-hardening.md
After=systemd-udevd.service
ConditionFileIsExecutable=/opt/vocat/current/vocat

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/vocat/current/vocat doctor --repair-dji-qmi --timeout 60s
TimeoutStartSec=5min
StandardOutput=null
StandardError=null
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=false
ProtectKernelTunables=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

# No install section: exact 2ca3:4006 USB add events activate an instance.
