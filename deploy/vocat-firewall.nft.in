# This transaction replaces only VoCat's table. It deliberately leaves every
# other nftables table unchanged.
destroy table inet vocat_ingress

table inet vocat_ingress {
	chain input {
		type filter hook input priority -5; policy accept;

		iifname "lo" tcp dport 7575 accept comment "vocat-policy-v3-loopback"
		ip saddr @PROXY_SOURCE_IPV4@ tcp dport 7575 accept comment "vocat-policy-v3-host-proxy"
		tcp dport 7575 reject with tcp reset comment "vocat-policy-v3-default-reject"
	}
}
