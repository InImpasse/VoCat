[Unit]
Description=Restrict VoCat port 7575 to the host reverse proxy
After=nftables.service
Wants=nftables.service
Before=vocat.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/vocat/vocat-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/vocat/vocat-firewall.nft
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
RequiredBy=vocat.service
