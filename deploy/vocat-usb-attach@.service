[Unit]
Description=Attach an allowlisted DJI USB modem (%i) to the VoCat VM
After=libvirtd.service systemd-udevd.service
Wants=libvirtd.service
ConditionPathExists=/etc/vocat/dji-usb.conf

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/vocat-usb-hotplug attach %i
User=root
Group=root
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/vocat-usb
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
